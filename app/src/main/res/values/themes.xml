<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal Material 3 base so the native splash inherits the brand.
         All real theming happens in Compose via CalSnapTheme. -->
    <style name="Theme.CalSnap" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.CalSnap.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/calsnap_bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CalSnap</item>
    </style>
</resources>
