<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules. We whitelist DataStore prefs but
     never the encrypted API key (those are bound to the device keystore
     and won't restore anyway). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file"   path="datastore/"/>
        <include domain="database" path="calsnap.db"/>
        <exclude domain="sharedpref" path="calsnap_secure.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file"   path="datastore/"/>
        <include domain="database" path="calsnap.db"/>
        <exclude domain="sharedpref" path="calsnap_secure.xml"/>
    </device-transfer>
</data-extraction-rules>
